{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gra:o:gf-contract:v002:candidate",
  "title": "GRA-O GF0-UGE candidate package V002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "task_id",
    "package_id",
    "package_mode",
    "producer_id",
    "principal_id",
    "claim_ids",
    "gate_ids",
    "horizon_complete_claim",
    "bindings",
    "artifacts",
    "gate_inputs",
    "gravity_applicability",
    "milestone_domains"
  ],
  "properties": {
    "contract_id": {"const": "GRA-O-GF0-UGE-CONTRACT-V002"},
    "task_id": {"const": "GRA-O-GF-CONTRACT"},
    "package_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "package_mode": {"enum": ["SCIENTIFIC", "SYNTHETIC_TEST"]},
    "producer_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "claim_ids": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["GF0", "GF1", "GF2", "GF3", "GE1", "GE2", "UGE"]}
    },
    "gate_ids": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "horizon_complete_claim": {"type": "boolean"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "gate_inputs": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/gateInput"}
    },
    "gravity_applicability": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/applicability"}
    },
    "milestone_domains": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/domain"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{1,159}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_artifact_ids", "principal_decision_artifact_id",
        "gamma_process_artifact_ids", "gamma_identification_artifact_ids",
        "seed_definition_artifact_id", "dilation_artifact_id",
        "platform_instantiation_artifact_id", "transport_artifact_id",
        "development_root_artifact_id", "validation_root_artifact_id",
        "access_log_artifact_id", "ancestry_artifact_id",
        "joined_evidence_artifact_id", "coverage_artifact_id",
        "public_release_artifact_id", "public_dataset_manifest_artifact_id",
        "executor_key_artifact_id", "execution_output_artifact_id",
        "execution_report_artifact_id", "execution_signature_artifact_id"
      ],
      "properties": {
        "framework_artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "principal_decision_artifact_id": {"$ref": "#/$defs/id"},
        "gamma_process_artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "gamma_identification_artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "seed_definition_artifact_id": {"$ref": "#/$defs/id"},
        "dilation_artifact_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "platform_instantiation_artifact_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "transport_artifact_id": {"$ref": "#/$defs/id"},
        "development_root_artifact_id": {"$ref": "#/$defs/id"},
        "validation_root_artifact_id": {"$ref": "#/$defs/id"},
        "access_log_artifact_id": {"$ref": "#/$defs/id"},
        "ancestry_artifact_id": {"$ref": "#/$defs/id"},
        "joined_evidence_artifact_id": {"$ref": "#/$defs/id"},
        "coverage_artifact_id": {"$ref": "#/$defs/id"},
        "public_release_artifact_id": {"$ref": "#/$defs/id"},
        "public_dataset_manifest_artifact_id": {"$ref": "#/$defs/id"},
        "executor_key_artifact_id": {"$ref": "#/$defs/id"},
        "execution_output_artifact_id": {"$ref": "#/$defs/id"},
        "execution_report_artifact_id": {"$ref": "#/$defs/id"},
        "execution_signature_artifact_id": {"$ref": "#/$defs/id"}
      }
    },
    "parent": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "role", "sha256", "byte_length", "storage", "locator", "payload_b64", "parents"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "role": {"enum": ["THEORY", "DEVELOPMENT", "VALIDATION", "EXTERNAL_CALIBRATION", "GENERIC", "PRODUCT"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1},
        "storage": {"enum": ["INLINE_JSON", "WORKSPACE_FILE"]},
        "locator": {"type": ["string", "null"]},
        "payload_b64": {"type": ["string", "null"]},
        "parents": {"type": "array", "items": {"$ref": "#/$defs/parent"}}
      }
    },
    "gateInput": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "rule_artifact_id", "evidence_artifact_id", "power_artifact_id", "prerequisite_gate_ids"],
      "properties": {
        "gate_id": {"type": "string"},
        "rule_artifact_id": {"$ref": "#/$defs/id"},
        "evidence_artifact_id": {"$ref": "#/$defs/id"},
        "power_artifact_id": {"$ref": "#/$defs/id"},
        "prerequisite_gate_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["characteristic_id", "applicability", "justification_artifact_id"],
      "properties": {
        "characteristic_id": {"type": "string"},
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
        "justification_artifact_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "domain_artifact_id"],
      "properties": {"claim_id": {"type": "string"}, "domain_artifact_id": {"$ref": "#/$defs/id"}}
    }
  }
}
