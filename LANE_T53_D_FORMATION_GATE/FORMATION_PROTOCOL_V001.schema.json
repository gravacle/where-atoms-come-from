        "surface_closure_gate_assay": {
          "$ref": "#/$defs/nonEmpty"
        },
        "falsifier": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "unifiedDynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "law_release_id",
        "law_release_hash",
        "C_psi_specification",
        "K_theta_specification",
        "M_phi_specification",
        "G_t_specification",
        "hold_specialization",
        "provenance_graph_specification",
        "measurable_primitives",
        "training_data_boundary",
        "held_out_data_boundary",
        "mode_predictions"
      ],
      "properties": {
        "law_release_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "law_release_hash": {
          "$ref": "#/$defs/sha256"
        },
        "C_psi_specification": {
          "const": "C_t = C_psi(X, W_t; p_C)"
        },
        "K_theta_specification": {
          "const": "R_(t+) ~ K_theta(R_t, C_t, B_t, G_t; p_S)"
        },
        "M_phi_specification": {
          "const": "Y_t ~ M_phi(R_t, Q_t; p_I)"
        },
        "G_t_specification": {
          "const": "G_t = MEASURABLE_SURFACE_CLOSURE_GATE"
        },
        "hold_specialization": {
          "const": "K_theta(R_t, OFF, H, CLOSED; p_S)"
        },
        "provenance_graph_specification": {
          "$ref": "#/$defs/nonEmpty"
        },
        "measurable_primitives": {
          "type": "array",
          "minItems": 1,
