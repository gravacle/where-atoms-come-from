      ],
      "properties": {
        "design": {
          "enum": [
            "RANDOMIZED_INTERVENTION",
            "PROSPECTIVE_NATURAL_CONTRAST"
          ]
        },
        "arms": {
          "const": [
            "FORMATION",
            "SHAM"
          ]
        },
        "randomized_intervention": {
          "$ref": "#/$defs/randomizedIntervention"
        },
        "prospective_natural_contrast": {
          "$ref": "#/$defs/prospectiveNaturalContrast"
        },
        "attrition_rule": {
          "$ref": "#/$defs/nonEmpty"
        },
        "deviation_rule": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "design": {
                "const": "RANDOMIZED_INTERVENTION"
              }
            },
            "required": [
              "design"
            ]
          },
          "then": {
            "required": [
              "randomized_intervention"
            ],
            "not": {
              "required": [
                "prospective_natural_contrast"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "design": {
                "const": "PROSPECTIVE_NATURAL_CONTRAST"
              }
            },
            "required": [
              "design"
            ]
          },
          "then": {
            "required": [
              "prospective_natural_contrast"
            ],
            "not": {
              "required": [
                "randomized_intervention"
              ]
            }
          }
        }
      ]
    },
