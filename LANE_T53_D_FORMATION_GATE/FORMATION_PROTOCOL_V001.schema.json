          }
        },
        "physical_location": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_surface_id",
        "surface_class",
        "bona_fide_record_surface_rationale",
        "sample_population",
        "target_state_coordinate",
        "state_representation",
        "single_trial_state_resolution",
        "earlier_event_X",
        "causal_signal_precedes_target_update_and_closure_assay",
        "interaction_origin",
        "provenance_hypothesis",
        "operating_range",
        "exclusions"
      ],
      "properties": {
        "actual_surface_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "surface_class": {
          "$ref": "#/$defs/nonEmpty"
        },
        "bona_fide_record_surface_rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "sample_population": {
