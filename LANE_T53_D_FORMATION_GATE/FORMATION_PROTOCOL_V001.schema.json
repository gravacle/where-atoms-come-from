            "writer_off_persistence",
            "read_only_or_preexisting",
            "rewriting",
            "erasure",
            "transient_response",
            "no_change"
          ],
          "properties": {
            "primary_formation": {
              "$ref": "#/$defs/modePrediction"
            },
            "derivative_copy_formation": {
              "$ref": "#/$defs/modePrediction"
            },
            "autonomous_endogenous_interaction": {
              "$ref": "#/$defs/modePrediction"
            },
            "engineered_exogenous_interaction": {
              "$ref": "#/$defs/modePrediction"
            },
            "writer_off_persistence": {
              "$ref": "#/$defs/modePrediction"
            },
            "read_only_or_preexisting": {
              "$ref": "#/$defs/modePrediction"
            },
            "rewriting": {
              "$ref": "#/$defs/modePrediction"
            },
            "erasure": {
              "$ref": "#/$defs/modePrediction"
            },
            "transient_response": {
              "$ref": "#/$defs/modePrediction"
            },
            "no_change": {
              "$ref": "#/$defs/modePrediction"
            }
          }
        }
      }
