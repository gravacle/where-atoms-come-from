{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://where-atoms-come-from.invalid/contracts/FORMATION_PROTOCOL_V001.schema.json",
  "title": "Frozen causally controlled physical record-formation protocol V001",
  "description": "Instantiation contract for a prospective BEFORE -> FORMATION/SHAM -> COMMON-HOLD -> READ test using either a randomized intervention or a prospective natural contrast on an engineered/exogenous or autonomous/endogenous actual physical surface. Response-blind archival holdouts are admissible. This schema supplies no universal numerical tolerance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "contract_version",
    "registration",
    "site",
    "scope",
    "unified_dynamics",
    "sequence",
    "causal_design",
    "before",
    "formation_interaction",
    "sham",
    "common_hold",
    "read",
    "analysis",
    "uncertainty_system",
    "transition_assays",
    "data_custody",
    "urm_execution",
    "independent_reproduction"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "FORMATION_PROTOCOL_V001"
    },
    "registration": {
      "$ref": "#/$defs/registration"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "unified_dynamics": {
      "$ref": "#/$defs/unifiedDynamics"
    },
    "sequence": {
      "const": [
        "BEFORE",
        "FORMATION_OR_SHAM",
        "COMMON_HOLD",
        "READ"
      ]
    },
    "causal_design": {
      "$ref": "#/$defs/causalDesign"
    },
    "before": {
      "$ref": "#/$defs/beforeStage"
    },
    "formation_interaction": {
      "$ref": "#/$defs/formationStage"
    },
    "sham": {
      "$ref": "#/$defs/shamStage"
    },
    "common_hold": {
      "$ref": "#/$defs/holdStage"
    },
    "read": {
      "$ref": "#/$defs/readStage"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "uncertainty_system": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/uncertaintyEntry"
      }
    },
    "transition_assays": {
      "$ref": "#/$defs/transitionAssays"
    },
    "data_custody": {
      "$ref": "#/$defs/dataCustody"
    },
    "urm_execution": {
      "$ref": "#/$defs/urmExecution"
    },
    "independent_reproduction": {
      "$ref": "#/$defs/independentReproduction"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "interaction_origin": {
                "const": "AUTONOMOUS_ENDOGENOUS"
              }
            },
            "required": [
              "interaction_origin"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "formation_interaction": {
            "required": [
              "endogenous_interaction",
              "endogenous_to_hold_boundary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "interaction_origin": {
                "const": "ENGINEERED_EXOGENOUS"
              }
            },
            "required": [
              "interaction_origin"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "formation_interaction": {
            "required": [
              "external_writer",
              "writer_target_coupling",
              "writer_off_boundary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "provenance_hypothesis": {
                "const": "DERIVATIVE_FROM_PARENT_RECORD"
              }
            },
            "required": [
              "provenance_hypothesis"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "parent_record"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "site": {
            "properties": {
              "role": {
                "const": "INDEPENDENT_REPRODUCTION"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "independent_reproduction": {
            "properties": {
              "declaration_status": {
                "const": "SIGNED"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timePoint": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "prospective_rationale"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/nonEmpty"
        },
        "prospective_rationale": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "positiveDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "prospective_rationale"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "$ref": "#/$defs/nonEmpty"
        },
        "prospective_rationale": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "registered_at",
        "registration_hash",
        "public_location",
        "data_source",
        "frozen_before_numerical_access_or_unblinding",
        "numerical_access_log_hash",
        "archival_custody_proof",
        "amendment_policy"
      ],
      "properties": {
        "status": {
          "const": "FROZEN_BEFORE_OUTCOME_ACCESS_OR_UNBLINDING"
        },
